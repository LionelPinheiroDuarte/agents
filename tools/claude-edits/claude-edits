#!/bin/bash
# Fuzzy-pick a file recently written by Claude Code, see what Claude changed
# in it, and open it in Vim in a new tmux window. Meant to run inside a tmux
# popup (see dotfiles' .tmux.conf).
#
# The data comes from the log-edits hook (agents/hooks/log-edits/): files are
# grouped by the Claude session that last touched them, newest first, deleted
# files skipped. "Before" is the file as it was before Claude's first edit in
# that session; "after" is the file on disk now.
#
#   claude-edits          all sessions
#   claude-edits <dir>    only files of the repo holding <dir> (e.g. the pane's)
#
# Keys in the list: enter = vim · ctrl-d = vimdiff before/after · ctrl-f = diff/file
#                   ctrl-g = this repo/all · ctrl-y = copy the path · ctrl-/ = preview
# Keys in Vim (claude-edits.vim): ,d = git-diff-like view · ,D = side-by-side vimdiff
#
# No dependency beyond fzf (>= 0.66), awk and coreutils; bat is used for the
# file view when present.

HERE="$(dirname "$(realpath "$0")")"
source "$HERE/../lib/popup.sh"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/claude"
LOG="$STATE/edits.log"
SNAPSHOTS="$STATE/snapshots"
PREVIEW=$(command -v batcat || command -v bat)
VIMSCRIPT="$HERE/claude-edits.vim"
BADGE="$BG_BLU"

# Snapshot directory of <path> in <session> (may not exist).
snapshot_dir() {
  echo "$SNAPSHOTS/${1:-unknown}/$(printf '%s' "$2" | sha1sum | cut -c1-40)"
}

# Print the "before" file kept in snapshot <dir> ("/dev/null" if Claude created
# the file), or nothing if there is no snapshot.
before_at() {
  [ -d "$1" ] || return
  if [ -e "$1/new" ]; then echo /dev/null; return; fi
  local origs=("$1"/*.orig)
  [ -e "${origs[0]}" ] && echo "${origs[0]}"
}

# Path shown to the user: relative to <base> when given, else to $GITHUB or ~.
short_path() {
  local f="$1" base="$2"
  if   [[ -n "$base" && "$f" == "$base"/* ]]; then echo "${f#"$base"/}"
  elif [[ "$f" == "$GITHUB_DIR"/* ]];         then echo "${f#"$GITHUB_DIR"/}"
  elif [[ "$f" == "$HOME"/* ]];               then echo "~/${f#"$HOME"/}"
  else                                             echo "$f"; fi
}

# Dim directory, bold file name.
render_path() {
  local p="$1"
  if [[ "$p" == */* ]]; then echo "${DIM}${p%/*}/${OFF}${BOLD}${p##*/}${OFF}"
  else                       echo "${BOLD}${p}${OFF}"; fi
}

# "+A -D" of <before> -> <after>, as two numbers; "0 0" when they match.
numstat() {
  diff "$1" "$2" | awk '/^>/ { a++ } /^</ { d++ } END { print a + 0, d + 0 }'
}

# The fzf input, one line per file under a header line per session:
#   <header>\t<row>\t<path>\t<epoch>\t<session>
# Also writes the number of headers to $GROUPS_FILE, for the counter.
list() {
  local scope="$1"
  local -a ts sess path syms adds dels
  local t s f before a d sym

  # newest first; files grouped by the session that touched them last, groups
  # ordered by their latest edit
  while IFS=$'\t' read -r t s f; do
    [[ -f "$f" && ( -z "$scope" || "$f" == "$scope"/* ) ]] || continue
    before=$(before_at "$(snapshot_dir "$s" "$f")")
    a="" d=""
    if [ -z "$before" ]; then
      sym="${DIM}?${OFF}"
    else
      read -r a d < <(numstat "$before" "$f")
      if   (( a + d == 0 ));         then sym="${DIM}↶${OFF}"
      elif [ "$before" = /dev/null ]; then sym="${GRN}✚${OFF}"
      else                                sym="${YLW}~${OFF}"; fi
    fi
    ts+=("$t") sess+=("$s") path+=("$f") syms+=("$sym") adds+=("$a") dels+=("$d")
  done < <(tac "$LOG" | awk -F'\t' '
    !seen[$3]++ { if (!($2 in n)) order[++groups] = $2; i = ++n[$2]; ts[$2, i] = $1; path[$2, i] = $3 }
    END { for (g = 1; g <= groups; g++) for (i = 1; i <= n[order[g]]; i++)
            print ts[order[g], i] "\t" order[g] "\t" path[order[g], i] }')

  # path column: whatever the list pane leaves after the mark, stats and age
  local i width=0 p max=$(( ${LIST_COLS:-70} - 26 ))
  (( max < 20 )) && max=20
  local -a shorts parts
  for i in "${!path[@]}"; do
    p=$(short_path "${path[i]}" "$scope")
    # too long: drop whole leading dirs, so the file name always stays readable
    if (( ${#p} > max )); then
      IFS=/ read -ra parts <<<"$p"
      while (( ${#parts[@]} > 1 )); do
        parts=("${parts[@]:1}")
        p="…/$(IFS=/; echo "${parts[*]}")"
        (( ${#p} <= max )) && break
      done
      (( ${#p} > max )) && p="…${p: -$(( max - 1 ))}"
    fi
    shorts+=("$p")
    (( ${#p} > width )) && width=${#p}
  done

  local group=-1 last="" label stat plus minus
  for i in "${!path[@]}"; do
    if [ "${sess[i]}" != "$last" ]; then
      last=${sess[i]}; (( group++ ))
      case $group in
        0) label="DERNIÈRE SESSION" ;;
        1) label="SESSION PRÉCÉDENTE" ;;
        *) label="SESSION" ;;
      esac
      printf '%s\t\t\t\t\n' "${DIM}${label} · $(since "${ts[i]}")${OFF}"
    fi
    if [ -z "${adds[i]}" ]; then
      printf -v stat '%s%11s%s' "$DIM" "sans diff" "$OFF"
    elif (( adds[i] + dels[i] == 0 )); then
      printf -v stat '%s%11s%s' "$DIM" "annulé" "$OFF"
    else
      minus="-${dels[i]}"; [ "$minus" = -0 ] && minus="·"
      printf -v stat '%s%5s%s %s%5s%s' "$GRN" "+${adds[i]}" "$OFF" "$RED" "$minus" "$OFF"
    fi
    p=${shorts[i]}
    printf '\t%s %s%*s  %s  %s%7s%s\t%s\t%s\t%s\n' \
      "${syms[i]}" "$(render_path "$p")" $(( width - ${#p} )) "" \
      "$stat" "$DIM" "$(ago "${ts[i]}")" "$OFF" \
      "${path[i]}" "${ts[i]}" "${sess[i]}"
  done

  # session headers are counted out of the "6/14" counter (see info_for)
  [ -n "$GROUPS_FILE" ] && echo $(( group + 1 )) >"$GROUPS_FILE"
}

# Right side of the input line: scope badge, ctrl-g hint, file count.
info_for() {
  local scope="$1" groups="$2" matched=$FZF_MATCH_COUNT total=$(( FZF_TOTAL_COUNT - $2 ))
  [ -z "$FZF_QUERY" ] && matched=$(( matched - groups ))
  if [ -n "$scope" ]; then printf '%s  %s' "${BADGE} $(basename "$scope") ${OFF}" "${DIM}tous ^G${OFF}"
  else                     printf '%s  %s' "${BLU}${BOLD}tous${OFF}" "${DIM}dépôt ^G${OFF}"; fi
  printf '  %s\n' "${DIM}·${OFF}  ${matched}/${total}"
}

# "diff · fichier" with the active view highlighted (ctrl-f).
tabs() {
  if [ "$1" = file ]; then echo "${DIM}diff${OFF} · ${BLU}${BOLD}fichier${OFF}"
  else                     echo "${BLU}${BOLD}diff${OFF} · ${DIM}fichier${OFF}"; fi
}

show_file() {
  if [ -n "$PREVIEW" ]; then "$PREVIEW" --color=always --style=numbers "$1"
  else awk -v d="$DIM" -v o="$OFF" '{ printf "%s%4d%s  %s\n", d, NR, o, $0 }' "$1"; fi
}

# A unified diff (on stdin) drawn for the preview: old and new line numbers,
# full-width background on added/removed lines, and the enclosing top-level
# line (function, class, import...) after each @@.
show_diff() {
  expand -t4 \
    | awk -v W="${FZF_PREVIEW_COLUMNS:-80}" -v off="$OFF" -v dim="$DIM" -v prp="$PRP" \
          -v add=$'\e[48;2;35;51;40m\e[38;2;140;201;143m' -v del=$'\e[48;2;58;38;41m\e[38;2;239;143;143m' '
      function fill(s,   n) { n = W - length(s); return n > 0 ? s sprintf("%" n "s", "") : s }
      NR <= 2 { next }
      /^@@/ {
        split($2, a, ","); split($3, b, ",")
        o = substr(a[1], 2); n = substr(b[1], 2)
        ctx = $0; sub(/^@@ [^@]*@@ ?/, "", ctx)
        printf "%s@@ %s,%s → %s,%s @@ %s%s\n", prp, o, a[2] == "" ? 1 : a[2], n, b[2] == "" ? 1 : b[2], ctx, off
        next
      }
      /^-/  { printf "%s%s%s\n", del, fill(sprintf("%4d       - %s", o++, substr($0, 2))), off; next }
      /^\+/ { printf "%s%s%s\n", add, fill(sprintf("     %4d  + %s", n++, substr($0, 2))), off; next }
      /^\\/ { printf "%s           %s%s\n", dim, substr($0, 3), off; next }
      { printf "%s%4d %4d    %s%s\n", dim, o++, n++, substr($0, 2), off }'
}

preview() {
  local path="$1" ts="$2" session="$3" mode="$4"
  [ -n "$path" ] || exit 0

  # path on the left, tabs on the right, clear of fzf's scroll counter
  local p; p=$(short_path "$path")
  printf '%s%*s%s\n' "$(render_path "$p")" \
    $(( ${FZF_PREVIEW_COLUMNS:-80} - ${#p} - 14 - 10 )) "" "$(tabs "$mode")"

  # one diff for the header's counts, the reverted check and the view
  local dir before u="" a d hunks
  dir=$(snapshot_dir "$session" "$path")
  before=$(before_at "$dir")
  [ -n "$before" ] && u=$(diff -u -F '^[[:alpha:]_$@]' "$before" "$path")
  read -r a d hunks < <(awk 'NR > 2 && /^\+/ { a++ } NR > 2 && /^-/ { d++ } /^@@/ { h++ }
                            END { print a + 0, d + 0, h + 0 }' <<<"$u")
  local origs=("$dir"/*.orig) edits
  [ -e "${origs[0]}" ] || origs=()
  edits="${#origs[@]} édition$( (( ${#origs[@]} > 1 )) && echo s)"

  local edited="édité par Claude $(since "$ts")"
  if [ -z "$before" ]; then
    echo "${DIM}$edited · sans snapshot : édité avant l'enregistrement des diffs${OFF}"
  elif [ -z "$u" ]; then
    echo "${DIM}$edited · annulé depuis : plus aucun changement · $edits${OFF}"
  else
    [ "$before" = /dev/null ] && edits="créé par Claude"
    echo "${DIM}$edited · ${GRN}+$a ${RED}-$d${DIM} · $hunks bloc$( (( hunks > 1 )) && echo s) · $edits${OFF}"
  fi
  echo "${DIM}$(printf '─%.0s' $(seq "${FZF_PREVIEW_COLUMNS:-80}"))${OFF}"

  if [ "$mode" = file ] || [ -z "$before" ] || [ "$before" = /dev/null ]; then
    show_file "$path"
  elif [ -n "$u" ]; then
    show_diff <<<"$u"
  fi
}

# Open a file in Vim in a new tmux window, with ,d ready to show Claude's diff.
# Extra args are passed to vim (e.g. -c ClaudeDiff to start in the diff).
open_in_vim() {
  local path="$1" before="$2"; shift 2
  local name; name=$(basename "$path")
  [ $# -gt 0 ] && name="diff:$name"
  tmux new-window -c "$(dirname "$path")" -n "$name" \
    "vim -c \"let g:claude_before='$before'\" -S '$VIMSCRIPT' $* '$path'"
}

case "$1" in
  --list)    GROUPS_FILE="$2.groups" list "$(cat "$2")"; exit 0 ;;
  --info)    info_for "$(cat "$2")" "$(cat "$2.groups" 2>/dev/null || echo 0)"; exit 0 ;;
  --preview) preview "$2" "$3" "$4" "$(cat "$5" 2>/dev/null)"; exit 0 ;;
  --toggle)
    if [ "$(cat "$2" 2>/dev/null)" = file ]; then echo diff >"$2"; else echo file >"$2"; fi
    exit 0
    ;;
  --scope)   # flip between the repo and all sessions
    if [ -s "$2" ]; then : >"$2"; elif [ -n "$3" ]; then echo "$3" >"$2"; fi
    exit 0
    ;;
  --vimdiff) # <path> <session>
    before=$(before_at "$(snapshot_dir "$3" "$2")")
    [ -n "$before" ] || exit 0
    open_in_vim "$2" "$before" -c ClaudeDiff
    exit 0
    ;;
esac

require_fzf

if [ ! -s "$LOG" ]; then
  echo "Aucune édition enregistrée ($LOG)."
  read -rsn1
  exit 0
fi

# the repo of <dir> (or of the current directory, for ctrl-g); the list starts
# filtered only when <dir> is given
repo=$(git -C "${1:-$PWD}" rev-parse --show-toplevel 2>/dev/null)
[ -z "$repo" ] && [ -n "$1" ] && repo=$(realpath "$1")

# the list pane's width, for the path column (inherited by ctrl-g's reload)
PREVIEW_PCT=58
cols=$(stty size </dev/tty 2>/dev/null | cut -d' ' -f2)
export LIST_COLS=$(( ${cols:-100} * (100 - PREVIEW_PCT) / 100 - 4 ))

self=$(realpath "$0")
MODE=$(mktemp) SCOPE=$(mktemp)
trap 'rm -f "$MODE" "$SCOPE" "$SCOPE.groups"' EXIT
[ -n "$1" ] && echo "$repo" >"$SCOPE"

# footer, under the list: shortcuts, then the marks' legend (fzf draws it in
# the list column, the preview keeps the full height)
footer="${KEY} ⏎ ${OFF} vim   ${KEY} ^D ${OFF} vimdiff   ${KEY} ^F ${OFF} diff/fichier
${KEY} ^G ${OFF} dépôt/tous   ${KEY} ^Y ${OFF} copier   ${KEY} ^/ ${OFF} aperçu
${GRN}✚${OFF} créé  ${YLW}~${OFF} modifié  ${DIM}↶${OFF} annulé  ${DIM}?${OFF} sans diff"

popup_fzf_opts '#82aaff' "✎ fichiers modifiés par claude" 'chercher un fichier'
sel=$("$self" --list "$SCOPE" \
  | fzf "${POPUP_FZF[@]}" --footer "$footer" \
        --info-command "'$self' --info '$SCOPE'" \
        --preview-window "right,$PREVIEW_PCT%,border-left" \
        --preview "'$self' --preview {3} {4} {5} '$MODE'" \
        --bind "ctrl-f:execute-silent('$self' --toggle '$MODE')+refresh-preview" \
        --bind "ctrl-d:execute-silent([ -n {3} ] && '$self' --vimdiff {3} {5})+abort" \
        --bind "ctrl-g:execute-silent('$self' --scope '$SCOPE' '$repo')+reload('$self' --list '$SCOPE')" \
        --bind "ctrl-y:execute-silent([ -n {3} ] && tmux set-buffer -w -- {3} && tmux display-message 'chemin copié : '{3})")

[ -n "$sel" ] || exit 0
file=$(cut -f3 <<<"$sel") session=$(cut -f5 <<<"$sel")
open_in_vim "$file" "$(before_at "$(snapshot_dir "$session" "$file")")"
