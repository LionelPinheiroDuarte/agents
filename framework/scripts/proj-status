#!/usr/bin/env bash
# One screen to start a session: git state, branches ahead of the default branch,
# recent CI runs, the roadmap's "Now". Read-only.
# Usage: proj-status [--no-ci]
#
# An executable `.proj-status` at the repo root is run at the end, for what only
# that project knows (build quota, deploy state…).

set -uo pipefail

ci=1
[ "${1:-}" = "--no-ci" ] && ci=0

root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "proj-status: not a git repository" >&2; exit 2; }
cd "$root" || exit 2

branch=$(git branch --show-current)
# Default branch: origin/HEAD if it names a branch that exists, else main or master.
default=""
for b in "$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')" main master; do
  [ -n "$b" ] || continue
  if git show-ref -q --verify "refs/heads/$b"; then default=$b; break; fi
  if git show-ref -q --verify "refs/remotes/origin/$b"; then default=origin/$b; break; fi
done

echo "## $(basename "$root") — ${branch:-detached} ($(git log -1 --format='%h %cr' 2>/dev/null))"

if git rev-parse -q --verify '@{u}' >/dev/null; then
  read -r behind ahead < <(git rev-list --left-right --count '@{u}...HEAD')
  [ "$ahead$behind" != "00" ] && echo "upstream: $ahead ahead, $behind behind (last fetch: $(stat -c %y .git/FETCH_HEAD 2>/dev/null | cut -d. -f1 || echo never))"
fi

dirty=$(git status --porcelain | wc -l)
[ "$dirty" -gt 0 ] && echo "uncommitted: $dirty file(s)"

if [ -n "$default" ]; then
  out=$(git for-each-ref --sort=-committerdate --format='%(refname:short)|%(committerdate:relative)' refs/heads |
    while IFS='|' read -r b when; do
      [ "$b" = "$default" ] && continue
      n=$(git rev-list --count "$default..$b")
      [ "$n" -gt 0 ] && echo "  $b: $n ahead of $default, last commit $when"
    done | head -8)
  [ -n "$out" ] && { echo "branches with work not in $default:"; echo "$out"; }
fi

if [ "$ci" -eq 1 ] && command -v gh >/dev/null && git remote get-url origin 2>/dev/null | grep -q github.com; then
  runs=$(timeout 10 gh run list --limit 3 --json workflowName,headBranch,status,conclusion,createdAt \
    --template '{{range .}}  {{.workflowName}} on {{.headBranch}}: {{if .conclusion}}{{.conclusion}}{{else}}{{.status}}{{end}} ({{timeago .createdAt}}){{"\n"}}{{end}}' 2>/dev/null)
  [ -n "$runs" ] && { echo "CI:"; echo "$runs"; }
fi

if [ -f docs/roadmap.md ]; then
  now=$(awk '/^## Now/{f=1;next} /^## /{f=0} f && NF {print; exit}' docs/roadmap.md)
  waiting=$(awk '/^## Waiting on/{f=1;next} /^## /{f=0} f && /^- /' docs/roadmap.md | wc -l)
  [ -n "$now" ] && echo "now: $now"
  [ "$waiting" -gt 0 ] && echo "waiting on: $waiting item(s) (docs/roadmap.md)"
fi

if [ -x .proj-status ]; then
  ./.proj-status
fi
